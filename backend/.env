

# 豆包API配置
DOUBAO_API_KEY=83e2399c-d79e-4c97-8307-2b1e9018ddc8
DOUBAO_SECRET_KEY=your_doubao_secret_key_here

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS配置
ALLOW_ORIGINS=*

# AI模型配置
AI_MODEL_TYPE=doubao  # 可选值：openai, doubao, ernie, qwen, hunyuan, claude, gemini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=100

# 数据库配置（可选，如需持久化存储）
DATABASE_URL=sqlite:///./app.db